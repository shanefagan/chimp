# Maintainer: Shane Fagan <shanepatrickfagan@gmail.com>
#
# Local package. Run ./make-source.sh first to pack the source tree (`just arch` and
# ../../install.sh do that for you).

pkgname=chimp
pkgver=0.10.0
pkgrel=1
pkgdesc="Use MIDI controllers (LPD8 mk2, KO II, MicroFreak...) to control KDE Plasma, plus a native LPD8 mk2 editor"
arch=('any')
license=('MIT')
depends=(
  'python'
  'pyside6'          # Qt Quick, QtDBus, QtWebSockets bindings
  'qt6-declarative'  # QtQuick runtime for the QML UI
  'qt6-websockets'   # OBS WebSocket client
  'kirigami'         # UI components
  'python-rtmidi'    # ALSA sequencer MIDI
  'python-numpy'     # Chimp Loop's mixer
  'python-yaml'      # Chimp Loop's kit files
  'qt6-multimedia'   # Chimp Loop's audio output
  'pipewire'         # pw-dump
  'wireplumber'      # wpctl (fallback volume control)
  'gtk3'             # gtk-launch, for "Launch app" actions
  'systemd'          # busctl, user service
  'hicolor-icon-theme'
  'layer-shell-qt'   # on-screen overlay above fullscreen windows
  'qqc2-desktop-style'  # the org.kde.desktop Qt Quick Controls style
)
optdepends=(
  'python-pulsectl: in-process volume/mute control (smoother knobs, no polling for pad lights)'
  'obs-studio: OBS scene/record/stream/mute actions'
  'bpfrag: Game volume knob follows the game bpfrag detects in a match'
  'python-evdev: gamepads (and a Wooting in gamepad mode) as Chimp Loop controllers'
)
conflicts=('lpd8mk2-editor' 'knobdeck')
replaces=('lpd8mk2-editor' 'knobdeck')
makedepends=('python-build' 'python-installer' 'python-hatchling')
checkdepends=('python-pytest')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  QT_QPA_PLATFORM=offscreen PYTHONPATH="$PWD" python -m pytest -q -p no:cacheprovider tests/test_*.py
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 packaging/chimp.desktop "$pkgdir/usr/share/applications/chimp.desktop"
  install -Dm644 packaging/chimp-loop.desktop "$pkgdir/usr/share/applications/chimp-loop.desktop"
  install -Dm644 chimp/icons/chimp.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/chimp.svg"
  install -Dm644 packaging/chimp.service "$pkgdir/usr/lib/systemd/user/chimp.service"
  install -Dm644 packaging/man/chimp.1 "$pkgdir/usr/share/man/man1/chimp.1"
  install -Dm644 packaging/man/chimpd.1 "$pkgdir/usr/share/man/man1/chimpd.1"
  install -Dm644 packaging/man/chimp-loop.1 "$pkgdir/usr/share/man/man1/chimp-loop.1"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
