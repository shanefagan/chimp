[Unit]
Description=Chimp: MIDI controllers control the desktop
Documentation=file:///usr/share/doc/chimp/README.md
PartOf=graphical-session.target
After=graphical-session.target pipewire.service

[Service]
ExecStart=/usr/bin/chimpd
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
